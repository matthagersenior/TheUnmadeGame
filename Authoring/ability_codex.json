  "schema_version": 1,
  "title": "THE UNMADE — Ability Codex",
  "goal": "Anything demonstrating a repeatable skill, technique, or supernatural principle may become a subject of study, but observation never automatically grants a power.",
  "authority": "Canonical index of discovery, acquisition and status; cited production C++ remains authoritative for runtime effect, costs and save identity until explicitly migrated.",
  "states": {
    "source_rule": "implemented portable rules, engine behavior unverified",
    "prototype_handler": "connected Unreal C++ source, uncompiled in engine",
    "definition_only": "registered but no verified usable unlock",
    "proposed": "future design, not available to player"
  },
  "observation_policy": {
    "evidence": "record witness identity and firsthand provenance",
    "research": "observe, infer, trial, master, then combine; no automatic copying",
    "consent": "respect the subject's consent and existing mystery",
    "unlock": "new unlocks require persistent save state and executable physical tests"
  },
